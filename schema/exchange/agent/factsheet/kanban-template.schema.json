{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-artist.inspire/schema/kanban-template.schema.json",
  "title": "Kanban Template",
  "description": "A reusable Kanban project-type template: named phases, each containing predefined tasks. On Execute plan each selected task becomes a backlog item carrying its owning phase's name.",
  "type": "object",
  "required": ["name", "phases"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier. May be omitted on import, in which case one is assigned."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable template name."
    },
    "description": {
      "type": "string",
      "description": "Optional summary of what the template is for."
    },
    "phases": {
      "type": "array",
      "description": "Ordered phases making up the template.",
      "items": { "$ref": "#/$defs/phase" }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["name", "tasks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    }
  }
}
