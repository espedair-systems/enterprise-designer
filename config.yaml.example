server:
  host: "0.0.0.0"
  port: 8088
  mode: "development" # development | production

database:
  driver: "postgres" # postgres | memory
  default_schema: BASE_BASE
  postgres:
    url: "postgres://base:base_secret@localhost:5432/base?sslmode=disable"
    max_open_conns: 25
    max_idle_conns: 5
    conn_max_lifetime: "15m"

auth:
  enabled: false
  jwt_secret: "base-artist-jwt-secret-key-change-in-prod"
  token_expiry: "24h"

tui:
  resolution: "1080p" # 1080p | 1440p | 4k | auto

# Architecture Operating System (Architecture OS) Artists & Services
artists:
  enterprise_artist:
    id: "enterprise-artist"
    name: "Enterprise Artist"
    url: "http://localhost:8080"
    enabled: true
    health_path: "/api/v1/health"
    timeout_sec: 3
    default_schema: "EA_BASE"
    description: "Enterprise Architecture Metamodel, Strategy, Capabilities & OKR Realization"

  business_artist:
    id: "business-artist"
    name: "Business Artist"
    url: "http://localhost:8082"
    enabled: true
    health_path: "/api/v1/health"
    timeout_sec: 3
    default_schema: "BA_BASE"
    description: "Business Architecture Metamodel, Capabilities, Value Streams & SIPOC Processes"

  ai_artist:
    id: "ai-artist"
    name: "AI Artist"
    url: "http://localhost:8083"
    enabled: true
    health_path: "/api/v1/health"
    timeout_sec: 3
    default_schema: "AI_BASE"
    description: "Autonomous Multi-Agent Orchestration, Prompt Graphs & Cognitive Toolchains"

  data_artist:
    id: "data-artist"
    name: "Data Artist"
    url: "http://localhost:8084"
    enabled: true
    health_path: "/api/v1/health"
    timeout_sec: 3
    default_schema: "DA_BASE"
    description: "Medallion Lakehouse Tiers, Data Mesh Products & Multi-Paradigm ERD Modeling"

  security_artist:
    id: "security-artist"
    name: "Security Artist"
    url: "http://localhost:8085"
    enabled: true
    health_path: "/api/v1/health"
    timeout_sec: 3
    default_schema: "SEC_BASE"
    description: "STRIDE Threat Modeling, Zero-Trust Posture & RBAC Identity Governance"

  technology_artist:
    id: "technology-artist"
    name: "Technology Artist"
    url: "http://localhost:8086"
    enabled: true
    health_path: "/api/v1/health"
    timeout_sec: 3
    default_schema: "TECH_BASE"
    description: "Multi-Cloud Platforms, Kubernetes Runtimes & Infrastructure Topology"

  application_artist:
    id: "application-artist"
    name: "Application Artist"
    url: "http://localhost:8087"
    enabled: true
    health_path: "/api/v1/health"
    timeout_sec: 3
    default_schema: "APP_BASE"
    description: "Enterprise Microservices Portfolio, C4 Diagrams & Application Contracts"

  platform_artist:
    id: "platform-artist"
    name: "Platform Artist"
    url: "http://localhost:8089"
    enabled: true
    health_path: "/api/v1/health"
    timeout_sec: 3
    default_schema: "PLAT_BASE"
    description: "Enterprise Connectors Hub, Workday HCM, Kafka Streams & Cloud Ingress"

  integration_artist:
    id: "integration-artist"
    name: "Integration Artist"
    url: "http://localhost:8091"
    enabled: true
    health_path: "/api/v1/health"
    timeout_sec: 3
    default_schema: "INT_BASE"
    description: "REST API Interfaces, CDC Ingestion Streams & OpenAPI Specifications"

  test_artist:
    id: "test-artist"
    name: "Test Artist"
    url: "http://localhost:8093"
    enabled: true
    health_path: "/api/v1/health"
    timeout_sec: 3
    default_schema: "TEST_BASE"
    description: "Continuous Verification, Automated Test Suites & Quality Engineering"

# Autonomous Agents & Knowledge Services
agents:
  enterprise_agent:
    id: "enterprise-agent"
    name: "Enterprise Agent"
    url: "http://localhost:8090"
    enabled: true
    has_ui: true
    transport: "http_web_spa"
    health_path: "/api/v1/health"
    timeout_sec: 3
    grpc_endpoint: "localhost:50051"
    storage_engine: "lancedb"
    vector_dim: 768
    description: "Autonomous Multi-Agent Architecture Synthesis & Knowledge Graph"
    tags:
      - "Multi-Agent Systems"
      - "LanceDB Vectors"
      - "OmniGraph Engine"
      - "Gemini 2.0 Flash"
      - "Artifact Synthesis"

  process_agent:
    id: "process-agent"
    name: "Process Agent"
    url: "http://localhost:8092"
    enabled: true
    has_ui: true
    transport: "http_web_spa"
    health_path: "/api/health"
    timeout_sec: 3
    description: "Autonomous Monte Carlo Discrete-Event Process Simulation & AI Modernization Engine"
    tags:
      - "Monte Carlo Simulation"
      - "Bottleneck Analysis"
      - "Process Cycle Efficiency"
      - "AI Modernization"
      - "BPMN 2.0 Flow"

  artifact_indexer:
    id: "artifact-indexer"
    name: "Artifact Indexer"
    url: "http://localhost:8095"
    enabled: true
    has_ui: false
    transport: "mcp_stdio_sse"
    health_path: "/health"
    timeout_sec: 3
    storage_engine: "lancedb"
    vector_dim: 768
    description: "Rust High-Performance Hexagonal AST Vector Indexer & OpenLineage Export"
    tags:
      - "Rust Hexagonal Core"
      - "LanceDB Vectors"
      - "AST Parser"
      - "OpenLineage Graph"
      - "MCP Headless Server"

integrations:
  hcm:
    enabled: true
    sync_interval: "1h"
  workday:
    enabled: true
    sync_interval: "1h"

telemetry:
  log_level: "info" # debug | info | warn | error
  enable_tracing: false
